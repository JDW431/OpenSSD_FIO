[global]
filename=
size=

bs=4k
direct=1
log_avg_msec=1000

[rand_write]
rw=randwrite

write_bw_log=./(디렉터리)/rand_write
write_iops_log=./(디렉터리)/rand_write
write_lat_log=./(디렉터리)/rand_write

[rand_read]
stonewall
rw=randread

write_bw_log=./(디렉터리)/rand_read
write_iops_log=./(디렉터리)/rand_read
write_lat_log=./(디렉터리)/rand_read

[global]
filename=
size=

bs=1m
direct=1
log_avg_msec=1000

[seq_write]
rw=write
write_bw_log=./(디렉터리)/seq_write
write_iops_log=./(디렉터리)/seq_write
write_lat_log=./(디렉터리)/seq_write

[seq_read]
stonewall
rw=read

write_bw_log=./(디렉터리)/seq_read
write_iops_log=./(디렉터리)/seq_read
write_lat_log=./(디렉터리)/seq_read
